# =============================================================
# Medical RAG — environment configuration
# Copy to .env and fill in.  .env is git-ignored; this file is not.
# =============================================================

# ---------- Runtime ----------
# auto | cpu | cuda | dml
# Default is "cpu": this machine has been losing power unexpectedly 1-7x/day
# for at least a month, on days with no GPU load too -- a general power/
# hardware reliability issue, not something DirectML specifically triggers
# (see src/medical_rag/device.py docstring for the full story). CPU-only is
# kept as a precaution against the RX590's ~225W draw while that hardware
# fault is undiagnosed, not because GPU load was shown to cause it. Set this
# to "dml"/"cuda"/"auto" as a deliberate, one-off choice (e.g. a manual
# benchmark, or a supervised full-corpus rebuild) when you want the speed.
DEVICE=cpu
LOG_LEVEL=INFO
# Optional ONNX page-layout analysis; enable only after validating on your PDF corpus.
PDF_LAYOUT_ANALYSIS=false

# ---------- Qdrant ----------
# No server required either way:
#   leave QDRANT_URL EMPTY -> embedded on-disk store at QDRANT_PATH (zero setup)
#   set QDRANT_URL         -> Qdrant Cloud or any reachable Qdrant instance
QDRANT_URL=
QDRANT_PATH=data/qdrant
# `QDRANT` is also accepted as the variable name for this key.
# Only needed when QDRANT_URL points at a remote cluster.
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_rag
# HNSW tuning (architecture: m=32, ef_construct=200)
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCT=200
QDRANT_HNSW_EF_SEARCH=200

# ---------- Groq (generation) ----------
# `GROK` is also accepted as the variable name for this key (it is a Groq
# `gsk_...` key regardless of the spelling).
GROQ_API_KEY=
# Groq retired the Llama 3.x models. If you get a 404 here, list what your key
# can actually reach with: python -c "from groq import Groq; print([m.id for m in
# Groq(api_key='...').models.list().data])"
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
# Maximum generated tokens per completion (the model's own limits still apply).
GROQ_MAX_TOKENS=32768
# Smaller/faster model used only for query expansion
GROQ_EXPANSION_MODEL=openai/gpt-oss-20b

# ---------- Embeddings (medical) ----------
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=512

# ---------- Chunking (architecture: threshold 85, overlap 20%) ----------
CHUNK_BREAKPOINT_PERCENTILE=85
CHUNK_OVERLAP_RATIO=0.20
CHUNK_MIN_TOKENS=64
# Word-ish tokens; 384 keeps BNF chunks under the embedding model's 512-subword limit.
CHUNK_MAX_TOKENS=384

# ---------- Retrieval ----------
DENSE_TOP_K=50
SPARSE_TOP_K=50
RRF_K=60
RERANK_CANDIDATES=40
FINAL_TOP_K=6

# ---------- Reranker (mandatory cross-encoder) ----------
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
RERANKER_BATCH_SIZE=16

# ---------- Query expansion ----------
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MODE=hybrid
QUERY_EXPANSION_MAX_VARIANTS=3

# ---------- Guardrails (strict) ----------
CONFIDENCE_THRESHOLD=0.8
REQUIRE_CITATIONS=true
DISCLAIMER_ENABLED=true

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Paths ----------
# Source PDFs live here (git-ignored). Override only if you keep them elsewhere.
RAW_DIR=RAW_DATA
